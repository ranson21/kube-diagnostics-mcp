# Copy to .env for local (stdio) development. All values are placeholders.
DIAG_MODE=hub                 # hub | probe
DIAG_TRANSPORT=stdio          # stdio | http
# DIAG_HTTP_PORT=8090
# DIAG_HTTP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# DIAG_NAMESPACES=faultlab    # comma-separated allow-list; empty = all RBAC permits
# DIAG_DEFAULT_NAMESPACE=faultlab
DIAG_ALLOW_ACTIVE_CHECKS=false
# DIAG_PROBE_TOKEN=REPLACE_WITH_RANDOM_TOKEN   # shared with probes
# DIAG_PROBE_PORT=9911
# DIAG_LOG_LEVEL=info
# DIAG_LOG_MAX_LINES=500
# DIAG_LOG_MAX_BYTES=262144
# DIAG_MAX_RESULT_BYTES=204800
# Providers (all optional):
# DIAG_PROMETHEUS_URL=http://localhost:9090
# DIAG_PROM_HTTP_METRIC=http_server_requests_seconds
# DIAG_PROM_SERVICE_LABEL=service
# DIAG_DATADOG_SITE=datadoghq.com  DIAG_DATADOG_API_KEY=...  DIAG_DATADOG_APP_KEY=...   (placeholder provider)
# DIAG_SPLUNK_URL=https://splunk:8089  DIAG_SPLUNK_TOKEN=...  DIAG_SPLUNK_INDEX=main     (placeholder provider)

# Copy to .env for local (stdio) development. All values are placeholders.
DIAG_MODE=hub                 # hub | probe
DIAG_TRANSPORT=stdio          # stdio | http
# DIAG_HTTP_PORT=8090
# DIAG_HTTP_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# DIAG_NAMESPACES=faultlab    # comma-separated allow-list; empty = all RBAC permits
# DIAG_DEFAULT_NAMESPACE=faultlab
DIAG_ALLOW_ACTIVE_CHECKS=false
# DIAG_PROBE_TOKEN=REPLACE_WITH_RANDOM_TOKEN   # shared with probes
# DIAG_PROBE_PORT=9911
# DIAG_LOG_LEVEL=info
# DIAG_LOG_MAX_LINES=500
# DIAG_LOG_MAX_BYTES=262144
# DIAG_MAX_RESULT_BYTES=204800
# Providers (all optional):
# DIAG_PROMETHEUS_URL=http://localhost:9090
# DIAG_PROM_HTTP_METRIC=http_server_requests_seconds
# DIAG_PROM_SERVICE_LABEL=service
# Datadog (keys can also come from DIAG_DATADOG_API_KEY_FILE / DIAG_DATADOG_APP_KEY_FILE)
# DIAG_DATADOG_SITE=datadoghq.com          # or datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
# DIAG_DATADOG_API_KEY=REPLACE
# DIAG_DATADOG_APP_KEY=REPLACE
# DIAG_DATADOG_SCOPE=env:prod              # extra tags on every query (comma-separated)
# DIAG_DATADOG_APM_OPERATION=servlet.request   # span name for trace metrics; http.request for non-Java
# DIAG_DATADOG_SERVICE_TAG=service
# DIAG_DATADOG_NAMESPACE_TAG=kube_namespace
# DIAG_DATADOG_RUM_APPLICATION=storefront
# DIAG_DATADOG_LOG_INDEXES=main,k8s
# DIAG_DATADOG_TIMEOUT_MS=15000
# Splunk Enterprise / Cloud REST API (token can also come from DIAG_SPLUNK_TOKEN_FILE)
# DIAG_SPLUNK_URL=https://splunk.internal:8089
# DIAG_SPLUNK_TOKEN=REPLACE
# DIAG_SPLUNK_AUTH_SCHEME=Bearer           # Bearer for authentication tokens, Splunk for session keys
# DIAG_SPLUNK_INDEX=k8s
# DIAG_SPLUNK_NAMESPACE_FIELD=namespace    # k8s.namespace.name for OpenTelemetry collectors
# DIAG_SPLUNK_SERVICE_FIELD=container_name # k8s.container.name for OpenTelemetry collectors
# DIAG_SPLUNK_REQUEST_LOG_SEARCH=sourcetype="nginx:json"   # enables golden signals from request logs
# DIAG_SPLUNK_REQUEST_STATUS_FIELD=status
# DIAG_SPLUNK_REQUEST_DURATION_FIELD=request_time
# DIAG_SPLUNK_REQUEST_PATH_FIELD=uri
# DIAG_SPLUNK_REQUEST_METHOD_FIELD=request_method
# DIAG_SPLUNK_VERIFY_TLS=true
# DIAG_SPLUNK_TIMEOUT_MS=30000
